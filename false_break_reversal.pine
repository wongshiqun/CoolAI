//@version=5
indicator("假突破/假跌破反转指标", overlay=true, max_labels_count=500)

// === 参数 ===
leftBars  = input.int(3, "枢轴左侧K线数", minval=1)
rightBars = input.int(3, "枢轴右侧K线数", minval=1)
atrLen    = input.int(14, "ATR周期", minval=1)
minPierceATR = input.float(0.10, "最小刺破幅度(ATR倍数)", minval=0.0, step=0.01)
useVolume = input.bool(false, "启用成交量过滤")
volLen    = input.int(20, "成交量均线周期", minval=1)
volMult   = input.float(1.0, "成交量倍数阈值", minval=0.1, step=0.1)
showLevels = input.bool(true, "显示最近关键位")

// === 枢轴高低点 ===
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

// === 过滤条件 ===
atr = ta.atr(atrLen)
volOk = not useVolume or (volume > ta.sma(volume, volLen) * volMult)

// === 假突破反转(看空): 价格上破前高，但收盘回落到前高下方 ===
pierceHigh = not na(lastSwingHigh) ? (high - lastSwingHigh) : na
fakeBreakout = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh and pierceHigh >= atr * minPierceATR and volOk

// === 假跌破反转(看多): 价格下破前低，但收盘收回到前低上方 ===
pierceLow = not na(lastSwingLow) ? (lastSwingLow - low) : na
fakeBreakdown = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow and pierceLow >= atr * minPierceATR and volOk

// === 画图 ===
plotshape(fakeBreakout, title="假突破反转(空)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="假突破")
plotshape(fakeBreakdown, title="假跌破反转(多)", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="假跌破")

// 显示最近关键位
plot(showLevels ? lastSwingHigh : na, title="最近前高", color=color.new(color.red, 30), linewidth=1, style=plot.style_linebr)
plot(showLevels ? lastSwingLow : na,  title="最近前低", color=color.new(color.green, 30), linewidth=1, style=plot.style_linebr)

// 着色提示
barcolor(fakeBreakout ? color.new(color.red, 0) : fakeBreakdown ? color.new(color.green, 0) : na)

// === 报警 ===
alertcondition(fakeBreakout, title="假突破反转(空)信号", message="{\"signal\":\"fake_breakout_reversal_short\",\"ticker\":\"{{ticker}}\",\"close\":{{close}}}")
alertcondition(fakeBreakdown, title="假跌破反转(多)信号", message="{\"signal\":\"fake_breakdown_reversal_long\",\"ticker\":\"{{ticker}}\",\"close\":{{close}}}")
